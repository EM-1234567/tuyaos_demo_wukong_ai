 	HCI_QUIRK_BROKEN_EXT_SCAN,
 
+	/*
+	 * When this quirk is set, LE Extended Advertising is treated as
+	 * unsupported even if the controller claims HCI_LE_EXT_ADV. Use
+	 * legacy LE Set Advertise Enable (0x200a) instead of Extended
+	 * Advertising HCI commands (0x2036-0x2039). Required for RTL8733BU
+	 * which advertises Extended Adv but rejects Set Ext Scan Rsp /
+	 * Enable with EINVAL (-22).
+	 *
+	 * This quirk can be set before hci_register_dev is called or
+	 * during the hdev->setup vendor callback.
+	 */
+	HCI_QUIRK_BROKEN_EXT_ADV,
+
 	/*
 	 * When this quirk is set, the HCI_OP_GET_MWS_TRANSPORT_CONFIG command is
 	 * disabled. This is required for some Broadcom controllers which
diff --git a/include/net/bluetooth/hci_core.h b/include/net/bluetooth/hci_core.h
index d26b57e87..e6a2558f5 100644
--- a/include/net/bluetooth/hci_core.h
+++ b/include/net/bluetooth/hci_core.h
@@ -1702,7 +1702,9 @@ void hci_conn_del_sysfs(struct hci_conn *conn);
 #define use_ext_conn(dev) ((dev)->commands[37] & 0x80)
 
 /* Extended advertising support */
-#define ext_adv_capable(dev) (((dev)->le_features[1] & HCI_LE_EXT_ADV))
+#define ext_adv_capable(dev) \
+	(((dev)->le_features[1] & HCI_LE_EXT_ADV) && \
+	 !test_bit(HCI_QUIRK_BROKEN_EXT_ADV, &(dev)->quirks))
 
 /* Maximum advertising length */
 #define max_adv_len(dev) \
diff --git a/net/bluetooth/hci_event.c b/net/bluetooth/hci_event.c
index 7c1df481e..dc313da85 100644
--- a/net/bluetooth/hci_event.c
+++ b/net/bluetooth/hci_event.c
@@ -1280,6 +1280,27 @@ static u8 hci_cc_le_read_local_features(struct hci_dev *hdev, void *data,
 
 	memcpy(hdev->le_features, rp->features, 8);
 
+	/* Controllers that falsely claim Extended Advertising must not
+	 * expose HCI_LE_EXT_ADV; otherwise MGMT/BlueZ will drive 0x2036-
+	 * 0x2039 and fail (e.g. RTL8733BU: Opcode 0x2038 failed: -22).
+	 */
+	if (test_bit(HCI_QUIRK_BROKEN_EXT_ADV, &hdev->quirks) &&
+	    (hdev->le_features[1] & HCI_LE_EXT_ADV)) {
+		hdev->le_features[1] &= ~HCI_LE_EXT_ADV;
+		bt_dev_info(hdev,
+			    "HCI_QUIRK_BROKEN_EXT_ADV: force legacy LE advertising");
+		/*
+		 * Legacy MGMT_OP_ADD_ADVERTISING ignores BlueZ MinInterval.
+		 * Default 0x0800 = 1.28s makes phones take forever to discover.
+		 * Use ~100ms so Tuya App / nRF find the device quickly.
+		 */
+		hdev->le_adv_min_interval = 0x00A0; /* 100 ms */
+		hdev->le_adv_max_interval = 0x00C0; /* 120 ms */
+		bt_dev_info(hdev,
+			    "HCI_QUIRK_BROKEN_EXT_ADV: LE ADV interval %u-%u (0.625ms units)",
+			    hdev->le_adv_min_interval, hdev->le_adv_max_interval);
+	}
+
 	return rp->status;
 }
 
