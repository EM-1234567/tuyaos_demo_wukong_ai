diff --git a/board/alientek/atk-dlrk3506/deploy-wukong-app.sh b/board/alientek/atk-dlrk3506/deploy-wukong-app.sh
new file mode 100755
index 00000000..27c78d45
--- /dev/null
+++ b/board/alientek/atk-dlrk3506/deploy-wukong-app.sh
@@ -0,0 +1,77 @@
+#!/bin/sh
+# =============================================================================
+# deploy-wukong-app.sh — stage a built tuyaos_demo_wukong_ai into the rootfs
+# overlay, and stamp /etc/wukong_ai_build to match it.
+#
+# There is no buildroot package for the app; it reaches the rootfs by sitting
+# in board/alientek/atk-dlrk3506/fs-overlay/ (see BR2_ROOTFS_OVERLAY in
+# configs/alientek_rk3506_defconfig). Copying the binary and writing the
+# version stamp used to be two manual steps, so they drifted: the stamp said
+# 1.0.86 while the shipped binary was 1.0.87. Since BLE_NETCFG_NOTES.md tells
+# people to trust /etc/wukong_ai_build when confirming what is on the board,
+# a lying stamp costs real debugging time.
+#
+# Both are written here, from the same source path, or neither is.
+#
+# Usage:
+#   ./deploy-wukong-app.sh                 # newest build under apps/output/
+#   ./deploy-wukong-app.sh 1.0.87          # that version
+#   ./deploy-wukong-app.sh /path/to/binary # explicit binary
+#
+# After this, rebuild the rootfs — copying into the overlay alone changes
+# nothing on the board:
+#   ./build.sh buildroot && ./build.sh firmware && ./build.sh updateimg
+# =============================================================================
+set -e
+
+SELF=$(readlink -f "$0")
+BOARD_DIR=$(dirname "$SELF")
+OVERLAY="$BOARD_DIR/fs-overlay"
+APP_NAME=tuyaos_demo_wukong_ai
+
+# buildroot/board/alientek/atk-dlrk3506 -> SDK root -> app source tree
+SDK_ROOT=$(readlink -f "$BOARD_DIR/../../../..")
+APP_OUT="$SDK_ROOT/app/$APP_NAME/apps/output"
+
+die() { echo "deploy-wukong-app: $*" >&2; exit 1; }
+
+case "$1" in
+"")
+    # Newest by mtime, not by version sort: 1.0.9 vs 1.0.87 sorts wrong as a
+    # string, and the thing you just built is what you almost always want.
+    [ -d "$APP_OUT" ] || die "no build output at $APP_OUT (run build_rk3506b.sh first)"
+    SRC_DIR=$(ls -1dt "$APP_OUT/${APP_NAME}_"*/ 2>/dev/null | head -1)
+    [ -n "$SRC_DIR" ] || die "no ${APP_NAME}_* directory under $APP_OUT"
+    SRC="${SRC_DIR%/}/$APP_NAME"
+    ;;
+*/*)
+    SRC=$1
+    ;;
+*)
+    SRC="$APP_OUT/${APP_NAME}_$1/$APP_NAME"
+    ;;
+esac
+
+[ -f "$SRC" ] || die "binary not found: $SRC"
+[ -d "$OVERLAY/usr/bin" ] || die "overlay missing: $OVERLAY/usr/bin"
+
+# Version comes from the build directory name (apps/output/<app>_<ver>/), which
+# is the only place it exists — the binary itself carries no reliable version
+# string, and the SDK's own log line is a stale hardcoded constant.
+SRC_PARENT=$(basename "$(dirname "$(readlink -f "$SRC")")")
+case "$SRC_PARENT" in
+"${APP_NAME}_"*) VER="${SRC_PARENT#${APP_NAME}_}" ;;
+*)               VER="unknown" ;;
+esac
+
+cp -f "$SRC" "$OVERLAY/usr/bin/$APP_NAME"
+chmod 0755 "$OVERLAY/usr/bin/$APP_NAME"
+printf 'build=%s %s\n' "$VER" "$(date +%Y-%m-%dT%H:%M:%S%z)" > "$OVERLAY/etc/wukong_ai_build"
+
+echo "deployed : $SRC"
+echo "       -> $OVERLAY/usr/bin/$APP_NAME"
+echo "version  : $VER"
+echo "md5      : $(md5sum "$OVERLAY/usr/bin/$APP_NAME" | cut -d' ' -f1)"
+echo "stamp    : $(cat "$OVERLAY/etc/wukong_ai_build")"
+echo
+echo "Now rebuild the rootfs: ./build.sh buildroot && ./build.sh firmware && ./build.sh updateimg"
